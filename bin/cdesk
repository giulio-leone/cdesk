#!/bin/bash
# cdesk - multiple Claude Desktop apps side by side, one account each.
#
# Each instance is an APFS-cloned Claude.app in ~/Applications with its own
# bundle name, icon colour and baked-in --user-data-dir, so it gets a separate
# Dock entry, a separate login and a separate history. Profiles and per-instance
# state live in ~/.claude-desktop-profiles, outside the bundle, so a rebuild
# never touches them and never breaks the bundle's code signature.
#
# /Applications/Claude.app stays untouched and is one of the accounts; you only
# create an instance for each *additional* account. `cdesk sync` first brings
# Claude.app up to Anthropic's latest release, then re-clones every instance
# behind it; the LaunchAgent installed by `cdesk autosync on` runs it hourly and
# whenever Claude.app changes.

set -euo pipefail

SRC="${CLAUDE_APP:-/Applications/Claude.app}"
PROFILES="${CDESK_PROFILES:-$HOME/.claude-desktop-profiles}"
APPS="$HOME/Applications"
AGENT="$HOME/Library/LaunchAgents/io.cdesk.cdesk-sync.plist"
STATE="$PROFILES/.state"
MAIN_DATA="$HOME/Library/Application Support/Claude"
CONFIG="${CDESK_CONFIG:-$HOME/.config/cdesk/instances.conf}"
BACKUPS="${CDESK_BACKUPS:-$HOME/.config/cdesk/backups}"
LATEST_DMG="https://api.anthropic.com/api/desktop/darwin/universal/dmg/latest/redirect"
ANTHROPIC_TEAM=Q6L2SF6YDW
PB=/usr/libexec/PlistBuddy
LSREG=/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister

usage() {
  cat <<'EOF'
usage: cdesk <command> [args]

  cdesk create <name> [#hex]   build "Claude <name>.app" with a tinted icon
  cdesk apply                  build everything listed in the config
  cdesk run <name>             launch it
  cdesk list                   instances, versions, running state, claude:// owner
  cdesk sync                   update Claude.app, rebuild every instance behind it (LaunchAgent runs this)
  cdesk claim <name>|main      give claude:// (login + connector callbacks) to one app
  cdesk main <name>            run <name>'s profile in Claude.app itself and drop its clone
  cdesk autosync on|off        (un)install the LaunchAgent that syncs on update
  cdesk backup <name>...       archive a profile (its login) under ~/.config/cdesk
  cdesk restore <name> [file]  put a profile back from the newest backup
  cdesk remove <name>          delete the app; keeps the profile
  cdesk remove <name> --purge  delete the app AND its login/history

Only one app may own claude://. Clones are built without it so the main
Claude.app keeps handling logins and connectors; `cdesk claim <name>` lends it
to a clone while you log that clone in, `cdesk claim main` gives it back.

Only Claude.app is signed by Anthropic, so only the account in it can register
this Mac with claude.ai (mobile and web "your computer", device verification).
`cdesk main <name>` puts that account there.

Config:   ~/.config/cdesk/instances.conf   (name<TAB>#hex, one per line)
Profiles: ~/.claude-desktop-profiles/<slug>   Apps: ~/Applications
EOF
}

slug_of()   { printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-'; }
bundle_of() { printf '%s/Claude %s.app' "$APPS" "$1"; }
marker_of() { printf '%s/%s' "$STATE" "$(slug_of "$1")"; }
name_of()   { local n; n="$(basename "$1" .app)"; printf '%s' "${n#Claude }"; }
src_version() { $PB -c "Print :CFBundleShortVersionString" "$SRC/Contents/Info.plist" 2>/dev/null; }
is_instance() { [ -f "$(marker_of "$(name_of "$1")")" ]; }

colour_for() {
  local n; n=$(( $(printf '%s' "$1" | cksum | cut -d' ' -f1) % 6 ))
  printf '%s' "3B82F6 10B981 8B5CF6 EF4444 F59E0B 06B6D4" | cut -d' ' -f$((n + 1))
}

# Recolour the icon by rotating its hue, keeping shape and shading intact.
tint_icon() {
  local bundle="$1" hex="$2" work
  work="$(mktemp -d)"
  python3 - "$SRC/Contents/Resources/electron.icns" "$work/icon.iconset" "$hex" <<'PY' || { rm -rf "$work"; return 0; }
import colorsys, os, sys
from PIL import Image

src, out, hex_colour = sys.argv[1], sys.argv[2], sys.argv[3].lstrip("#")
r, g, b = (int(hex_colour[i:i + 2], 16) / 255 for i in (0, 2, 4))
target_h = int(colorsys.rgb_to_hsv(r, g, b)[0] * 255) % 256

base = Image.open(src)
sizes = base.info.get("sizes")
if sizes:
    base.size = max(sizes, key=lambda s: s[0])[:2]
base.load()
base = base.convert("RGBA")
alpha = base.getchannel("A")

# Constant hue, original saturation and value: coloured areas take the new hue,
# greys stay grey because their saturation is already near zero.
h, s, v = base.convert("RGB").convert("HSV").split()
tinted = Image.merge("HSV", (h.point(lambda _: target_h), s, v)).convert("RGB")
tinted.putalpha(alpha)

os.makedirs(out, exist_ok=True)
for size in (16, 32, 128, 256, 512):
    tinted.resize((size, size), Image.LANCZOS).save(f"{out}/icon_{size}x{size}.png")
    tinted.resize((size * 2, size * 2), Image.LANCZOS).save(f"{out}/icon_{size}x{size}@2x.png")
PY
  if [ -d "$work/icon.iconset" ]; then
    iconutil -c icns "$work/icon.iconset" -o "$bundle/Contents/Resources/electron.icns" 2>/dev/null || true
  fi
  rm -rf "$work"
}

# url_claims <bundle> on|off — copy CFBundleURLTypes from Claude.app, or drop it.
url_claims() {
  python3 - "$1/Contents/Info.plist" "$2" "$SRC/Contents/Info.plist" <<'PY'
import plistlib, sys
target, mode, source = sys.argv[1], sys.argv[2], sys.argv[3]
with open(target, "rb") as fh:
    data = plistlib.load(fh)
if mode == "on":
    with open(source, "rb") as fh:
        data["CFBundleURLTypes"] = plistlib.load(fh).get("CFBundleURLTypes", [])
else:
    data.pop("CFBundleURLTypes", None)
with open(target, "wb") as fh:
    plistlib.dump(data, fh)
PY
}

# macOS (Spotlight/XProtect) can still be walking a freshly written .app when we
# try to delete it, and a failed rm makes the next cp nest the bundle inside
# itself. Retry, then give up loudly rather than corrupting the tree.
hard_rm() {
  local p="$1" i
  for i in 1 2 3 4 5; do
    [ -e "$p" ] || return 0
    rm -rf "$p" 2>/dev/null || true
    [ -e "$p" ] || return 0
    sleep 1
  done
  echo "could not remove $p" >&2
  return 1
}

# `codesign --deep` is unreliable on nested frameworks (Apple deprecates it for
# signing). Sign inside-out instead: nested bundles deepest-first, then loose
# helper binaries, then the outer bundle.
sign_bundle() {
  local b="$1" p
  # Frameworks are copied verbatim, so Anthropic's signature on them is still
  # valid: leaving them alone keeps their APFS clone blocks shared with
  # /Applications/Claude.app instead of dirtying ~200 MB per instance.
  while IFS= read -r p; do
    codesign --force --sign - "$p" 2>>/tmp/cdesk-codesign.err || return 1
  done < <(find "$b/Contents" -type d -name '*.app' 2>/dev/null \
             | awk '{n=gsub(/\//,"/"); print n"\t"$0}' | sort -rn | cut -f2-)
  # CFBundleExecutable is our launcher shim, so codesign treats the real Electron
  # binary next to it as a loose resource and would leave Anthropic's signature
  # on it — which seals the original Info.plist and fails verification.
  # Anthropic signs Claude.app with com.apple.security.virtualization, which the
  # Cowork VM needs. An ad-hoc re-sign drops every entitlement, and the app then
  # reports "virtualization_entitlement_missing" and tells the user the
  # installation is damaged. The entitlements belong on the real Electron binary,
  # not on the bundle: CFBundleExecutable is our launcher script, and a script
  # carries no signature to embed them in. Drop the keys that name Anthropic's
  # team — an ad-hoc signature may not claim those.
  local ents k; ents="$(mktemp)"
  if codesign -d --entitlements :- "$SRC" 2>/dev/null > "$ents" && [ -s "$ents" ]; then
    for k in com.apple.application-identifier com.apple.developer.team-identifier \
             keychain-access-groups; do
      $PB -c "Delete :$k" "$ents" >/dev/null 2>&1 || true
    done
  else
    : > "$ents"
  fi
  local main_bin="$(basename "$b" .app)"
  while IFS= read -r p; do
    file -b "$p" | grep -q 'Mach-O' || continue
    if [ "$(basename "$p")" = "$main_bin" ] && [ -s "$ents" ]; then
      codesign --force --sign - --entitlements "$ents" "$p" \
        2>>/tmp/cdesk-codesign.err || { rm -f "$ents"; return 1; }
    else
      codesign --force --sign - "$p" 2>>/tmp/cdesk-codesign.err \
        || { rm -f "$ents"; return 1; }
    fi
  done < <(find "$b/Contents/MacOS" "$b/Contents/Helpers" -maxdepth 1 -type f -perm -111 2>/dev/null)
  rm -f "$ents"
  codesign --force --sign - "$b" 2>>/tmp/cdesk-codesign.err
}

# In bypass permissions mode the app is meant to start side sessions without a
# card (its forceAskVerdict stands down with "bypass"), but some runtime checks
# keep it from doing so and every start_session/hand_off_to_session in a new
# place waits for a click. Patch the clone's main-process code so bypass mode
# always stands down for those two tools, then rewrite app.asar and its
# ElectronAsarIntegrity hash. The app still records the place grant itself.
# Idempotent; refuses (and leaves the bundle untouched) when the code changed.
patch_bypass_start() {
  python3 - "$1" <<'PY'
import hashlib, json, os, plistlib, re, struct, sys

bundle = sys.argv[1]
asar = os.path.join(bundle, "Contents/Resources/app.asar")
plist = os.path.join(bundle, "Contents/Info.plist")
mark = b"/*cdesk:bypass-start*/"
patches = [
    # forceAskVerdict(tool, input, sessionId, ...): bypass stands down for start tools.
    (re.compile(rb"async forceAskVerdict\((\w+),\w+,(\w+),\w+,\w+\)\{"),
     lambda m: m.group(0) + mark + b'if(/(^|__)(start_session|hand_off_to_session)$/.test(' + m.group(1)
     + b')&&this.config.getSession(' + m.group(2) + b')?.permissionMode==="bypassPermissions")return{standDown:"bypass"};'),
    # canUseTool: allow on that stand-down without the extra ask-rule conditions.
    (re.compile(rb'else if\(\w+&&(\w+)&&\w+&&(\(await this\.forceAskVerdict\(\w+,\w+,\w+\)\)\.standDown==="bypass")&&await \w+\(\)===!1\)'),
     lambda m: b"else if(" + m.group(1) + b"&&" + m.group(2) + b")"),
]

with open(asar, "rb") as f:
    _, hsize, _, jlen = struct.unpack("<IIII", f.read(16))
    header = json.loads(f.read(jlen))
    f.seek(8 + hsize)
    blob = f.read()

entries = []
def walk(node, path):
    for k, v in node["files"].items():
        p = f"{path}/{k}" if path else k
        if "files" in v:
            walk(v, p)
        elif "offset" in v:
            entries.append((p, v))
walk(header, "")

def data_of(v):
    o = int(v["offset"])
    return blob[o:o + v["size"]]

target = [(p, v) for p, v in entries if p.startswith(".vite/build/") and b"async forceAskVerdict(" in data_of(v)]
if len(target) != 1:
    sys.exit(f"patch_bypass_start: expected one file with forceAskVerdict, found {len(target)}")
path, node = target[0]
code = data_of(node)
if mark in code:
    print(f"patch_bypass_start: {bundle} already patched")
    sys.exit(0)
for rx, repl in patches:
    code, n = rx.subn(repl, code)
    if n != 1:
        sys.exit(f"patch_bypass_start: {rx.pattern[:40]!r} matched {n} times in {path}; app code changed")

out, pos, shared = [], 0, {}
for p, v in sorted(entries, key=lambda e: int(e[1]["offset"])):
    key = None if v is node else (v["offset"], v["size"])  # identical files share one copy
    if key in shared:
        v["offset"] = shared[key]
        continue
    if key:
        shared[key] = str(pos)
    data = code if v is node else data_of(v)
    if v is node:
        bs = v["integrity"]["blockSize"]
        v["size"] = len(data)
        v["integrity"]["hash"] = hashlib.sha256(data).hexdigest()
        v["integrity"]["blocks"] = [hashlib.sha256(data[i:i + bs]).hexdigest() for i in range(0, len(data), bs)]
    v["offset"] = str(pos)
    out.append(data)
    pos += len(data)

hjson = json.dumps(header, separators=(",", ":")).encode()
inner = (len(hjson) + 4 + 3) // 4 * 4
tmp = asar + ".cdesk-tmp"
with open(tmp, "wb") as f:
    f.write(struct.pack("<IIII", 4, inner + 4, inner, len(hjson)))
    f.write(hjson + b"\0" * (inner - 4 - len(hjson)))
    for d in out:
        f.write(d)
os.replace(tmp, asar)

with open(plist, "rb") as f:
    info = plistlib.load(f)
info["ElectronAsarIntegrity"]["Resources/app.asar"]["hash"] = hashlib.sha256(hjson).hexdigest()
with open(plist + ".cdesk-tmp", "wb") as f:
    plistlib.dump(info, f)
os.replace(plist + ".cdesk-tmp", plist)
print(f"patch_bypass_start: patched {path} in {bundle}")
PY
}

scheme_owner() {
  local f; f="$(mktemp -d)/h.swift"
  cat > "$f" <<'EOF'
import AppKit
if let u = URL(string: "claude://x"), let a = NSWorkspace.shared.urlForApplication(toOpen: u) {
  print(a.path)
}
EOF
  swift "$f" 2>/dev/null || echo "unknown"
}

set_scheme_owner() {
  local f; f="$(mktemp -d)/s.swift"
  cat > "$f" <<EOF
import AppKit
import CoreServices
if let b = Bundle(path: "$1"), let id = b.bundleIdentifier {
  LSSetDefaultHandlerForURLScheme("claude" as CFString, id as CFString)
}
EOF
  swift "$f" 2>/dev/null || true
}

# Build into a staging bundle and swap it in, so a half-finished or still-busy
# instance can never be copied into (which nests Claude.app inside itself).
build() {
  local name="$1" hex="$2" slug bundle stage stagedir disp
  slug="$(slug_of "$name")"
  bundle="$(bundle_of "$name")"
  disp="Claude $name"

  [ -d "$SRC" ] || { echo "not found: $SRC" >&2; return 1; }
  mkdir -p "$APPS" "$STATE" "$PROFILES/$slug"

  # Stage outside ~/Applications: a half-built .app there gets picked up by
  # LaunchServices and Spotlight while we are still editing it.
  stagedir="$(mktemp -d "$PROFILES/.build.XXXXXX")"
  stage="$stagedir/$disp.app"
  cp -Rc "$SRC" "$stage" 2>/dev/null || cp -R "$SRC" "$stage"

  $PB -c "Set :CFBundleName $disp" "$stage/Contents/Info.plist"
  $PB -c "Add :CFBundleDisplayName string $disp" "$stage/Contents/Info.plist" 2>/dev/null \
    || $PB -c "Set :CFBundleDisplayName $disp" "$stage/Contents/Info.plist"
  $PB -c "Set :CFBundleIdentifier com.anthropic.claudefordesktop.cdesk.$slug" "$stage/Contents/Info.plist"
  $PB -c "Set :CFBundleExecutable $disp-launcher" "$stage/Contents/Info.plist"

  # Electron resolves its helper bundles from CFBundleName, so they must follow.
  local h base suffix newbase
  for h in "$stage/Contents/Frameworks/"Claude*Helper*.app; do
    [ -d "$h" ] || continue
    base="$(basename "$h" .app)"
    suffix="${base#Claude Helper}"
    newbase="$disp Helper$suffix"
    mv "$h/Contents/MacOS/$base" "$h/Contents/MacOS/$newbase"
    $PB -c "Set :CFBundleExecutable $newbase" "$h/Contents/Info.plist"
    $PB -c "Set :CFBundleName $newbase" "$h/Contents/Info.plist"
    $PB -c "Set :CFBundleIdentifier com.anthropic.claudefordesktop.cdesk.$slug.helper$(printf '%s' "$suffix" | tr -d ' ()')" "$h/Contents/Info.plist" 2>/dev/null || true
    mv "$h" "$(dirname "$h")/$newbase.app"
  done

  # The real binary keeps the display name so Activity Monitor shows it; the
  # launcher shim is what LaunchServices starts, and it injects the profile.
  mv "$stage/Contents/MacOS/Claude" "$stage/Contents/MacOS/$disp"
  cat > "$stage/Contents/MacOS/$disp-launcher" <<EOF
#!/bin/bash
# Per-instance environment (e.g. an API gateway for the Code tab). It lives in
# the profile, not in the bundle, so a rebuild or an update never drops it.
if [ -f "$PROFILES/$slug/env" ]; then
  set -a; . "$PROFILES/$slug/env"; set +a
fi
exec "\$(dirname "\$0")/$disp" --user-data-dir="$PROFILES/$slug" "\$@"
EOF
  chmod +x "$stage/Contents/MacOS/$disp-launcher"

  [ -n "$hex" ] && tint_icon "$stage" "$hex"

  # Only one app may own claude://. A clone that also claims it steals every
  # OAuth and connector callback from the main app, which then fails silently.
  url_claims "$stage" off

  patch_bypass_start "$stage" || echo "warning: $name keeps the start-session card in bypass mode" >&2

  # --deep signing occasionally trips over a still-settling helper; one retry
  # turns that transient into a no-op instead of a silently skipped instance.
  local attempt signed=0
  : > /tmp/cdesk-codesign.err
  for attempt in 1 2 3; do
    if sign_bundle "$stage" && codesign --verify --deep "$stage" 2>>/tmp/cdesk-codesign.err; then
      signed=1; break
    fi
    sleep 1
  done
  if [ "$signed" -eq 0 ]; then
    echo "codesign failed for $name: $(grep -v 'replacing existing signature' /tmp/cdesk-codesign.err | tail -1)" >&2
    rm -rf "$stagedir"
    return 1
  fi

  if ! hard_rm "$bundle"; then rm -rf "$stagedir"; return 1; fi
  mv "$stage" "$bundle"
  rm -rf "$stagedir"
  printf '%s\n%s\n' "$(src_version)" "$hex" > "$(marker_of "$name")"
  "$LSREG" -f "$bundle" >/dev/null 2>&1 || true
  echo "built $bundle  (profile: $PROFILES/$slug)"
}

# The declarative instance list. `cdesk apply` rebuilds a machine from it, so a
# fresh Mac needs the repo and this one file — no re-configuring by hand.
config_put() {
  local name="$1" hex="$2"
  mkdir -p "$(dirname "$CONFIG")"
  touch "$CONFIG"
  grep -viE "^$name[[:space:]]" "$CONFIG" > "$CONFIG.tmp" || true
  printf '%s\t#%s\n' "$name" "${hex#\#}" >> "$CONFIG.tmp"
  sort -f -o "$CONFIG" "$CONFIG.tmp" && rm -f "$CONFIG.tmp"
}

config_drop() {
  [ -f "$CONFIG" ] || return 0
  grep -viE "^$1[[:space:]]" "$CONFIG" > "$CONFIG.tmp" || true
  mv "$CONFIG.tmp" "$CONFIG"
}

cmd_create() {
  local name="$1" hex="${2:-}"
  [ -n "$hex" ] || hex="$(colour_for "$name")"
  build "$name" "${hex#\#}"
  config_put "$name" "$hex"
}

cmd_apply() {
  local name hex made=0 kept=0 cur
  [ -f "$CONFIG" ] || { echo "no config at $CONFIG"; return 0; }
  cur="$(src_version)"
  while IFS=$'\t' read -r name hex; do
    [ -n "$name" ] || continue
    case "$name" in \#*) continue ;; esac
    local marker; marker="$(marker_of "$name")"
    if [ -d "$(bundle_of "$name")" ] && [ -f "$marker" ] && [ "$(head -1 "$marker")" = "$cur" ]; then
      kept=$((kept + 1)); continue
    fi
    build "$name" "${hex#\#}" || { echo "apply: skipped $name" >&2; continue; }
    made=$((made + 1))
  done < "$CONFIG"
  echo "apply: $made built, $kept already current"
}

# A profile holds the logged-in session, so a backup means you do not have to log
# in again after a rebuild or a reinstall. It stays tied to this Mac: the cookies
# are encrypted with the local "Claude Safe Storage" keychain key.
cmd_backup() {
  local name slug out stamp
  mkdir -p "$BACKUPS"; chmod 700 "$BACKUPS"
  stamp="$(date +%Y%m%d-%H%M%S)"
  for name in "$@"; do
    slug="$(slug_of "$name")"
    [ -d "$PROFILES/$slug" ] || { echo "no profile for $name" >&2; continue; }
    out="$BACKUPS/$slug-$stamp.tgz"
    tar -czf "$out" -C "$PROFILES" "$slug"
    chmod 600 "$out"
    echo "backed up $name -> $out  ($(du -h "$out" | cut -f1))"
  done
  echo "these archives contain live session cookies — keep them off git and off shared drives"
}

cmd_restore() {
  local name="$1" src="${2:-}" slug
  slug="$(slug_of "$name")"
  if [ -z "$src" ]; then
    src="$(ls -t "$BACKUPS/$slug-"*.tgz 2>/dev/null | head -1 || true)"
  fi
  [ -n "$src" ] && [ -f "$src" ] || { echo "no backup found for $name in $BACKUPS" >&2; exit 1; }
  pgrep -f -- "--user-data-dir=$PROFILES/$slug" >/dev/null 2>&1 \
    && { echo "quit Claude $name first — its profile is in use" >&2; exit 1; }
  rm -rf "${PROFILES:?}/$slug"
  tar -xzf "$src" -C "$PROFILES"
  echo "restored $name from $src"
}

# Re-clone every instance that is behind the current Claude.app.
# Claude.app updates itself only while it runs, and the clones never can: their
# Squirrel updater looks for the downloaded bundle under the clone's identifier
# and fails on every check. So cdesk installs new releases into Claude.app itself,
# from Anthropic's download endpoint, accepting only a bundle Anthropic signed.
update_main() {
  local url ver cur tmp new
  url="$(curl -fsS -o /dev/null -w '%{redirect_url}' "$LATEST_DMG")" || return 1
  ver="$(printf '%s' "$url" | sed -nE 's#^https://downloads\.claude\.ai/releases/darwin/universal/([0-9.]+)/[^/]+\.dmg$#\1#p')"
  [ -n "$ver" ] || { echo "update: unexpected download URL: $url" >&2; return 1; }
  cur="$(src_version)"
  [ "$(printf '%s\n%s\n' "$cur" "$ver" | sort -V | tail -1)" != "$cur" ] || return 0
  if pgrep -f "^$SRC/Contents/MacOS/Claude( |\$)" >/dev/null; then
    echo "update: Claude.app is running and updates itself to $ver"
    return 0
  fi

  tmp="$(mktemp -d "$PROFILES/.update.XXXXXX")"
  new="$tmp/mnt/Claude.app"
  if ! { curl -fsSL "$url" -o "$tmp/Claude.dmg" \
         && diskutil image attach --readOnly --nobrowse --mountPoint "$tmp/mnt" "$tmp/Claude.dmg" >/dev/null; }; then
    rm -rf "$tmp"; echo "update: download of $ver failed" >&2; return 1
  fi
  if ! { [ "$($PB -c 'Print :CFBundleIdentifier' "$new/Contents/Info.plist")" = com.anthropic.claudefordesktop ] \
         && [ "$($PB -c 'Print :CFBundleShortVersionString' "$new/Contents/Info.plist")" = "$ver" ] \
         && codesign --verify --deep --strict "$new" 2>/dev/null \
         && codesign -dv "$new" 2>&1 | grep -x "TeamIdentifier=$ANTHROPIC_TEAM" >/dev/null \
         && spctl --assess --type execute "$new" 2>/dev/null \
         && ditto "$new" "$tmp/Claude.app"; }; then
    hdiutil detach -quiet "$tmp/mnt"; rm -rf "$tmp"
    echo "update: $ver rejected (identity or signature check failed)" >&2; return 1
  fi
  hdiutil detach -quiet "$tmp/mnt"
  mv "$SRC" "$tmp/previous.app"
  mv "$tmp/Claude.app" "$SRC"
  rm -rf "$tmp"
  "$LSREG" -f "$SRC" >/dev/null 2>&1 || true
  echo "update: Claude.app $cur -> $ver"
}

cmd_sync() {
  local cur v hex name n=0
  update_main || echo "update: keeping Claude.app $(src_version)" >&2
  cur="$(src_version)"
  shopt -s nullglob
  for bundle in "$APPS"/Claude\ *.app; do
    is_instance "$bundle" || continue
    name="$(name_of "$bundle")"
    v="$(head -1 "$(marker_of "$name")")"
    hex="$(sed -n 2p "$(marker_of "$name")")"
    [ "$v" = "$cur" ] && continue
    # Swapping the bundle under a running Electron app leaves it spawning helpers
    # from the new version; the hourly LaunchAgent run picks it up once it quits.
    if pgrep -f -- "--user-data-dir=$PROFILES/$(slug_of "$name")" >/dev/null; then
      echo "sync: $name is running; rebuilt after it quits"
      continue
    fi
    build "$name" "$hex" || { echo "sync: skipped $name" >&2; continue; }
    n=$((n + 1))
  done
  echo "sync: $n rebuilt (Claude.app $cur)"
}

cmd_list() {
  local running cur v name mark
  cur="$(src_version)"
  echo "Claude.app: $cur$([ -L "$MAIN_DATA" ] && echo "   (profile: $(readlink "$MAIN_DATA"))" || true)"
  echo "claude:// : $(scheme_owner)"
  running="$(ps -Ao command | grep -F -- '--user-data-dir=' || true)"
  shopt -s nullglob
  for bundle in "$APPS"/Claude\ *.app; do
    is_instance "$bundle" || continue
    name="$(name_of "$bundle")"
    v="$(head -1 "$(marker_of "$name")")"
    mark="  "
    case "$running" in *"--user-data-dir=$PROFILES/$(slug_of "$name")"*) mark="● " ;; esac
    printf '%s%-16s %s%s\n' "$mark" "$name" "$v" \
      "$([ "$v" = "$cur" ] && echo "" || echo "   (stale -> cdesk sync)")"
  done
}

cmd_run() {
  local bundle; bundle="$(bundle_of "$1")"
  [ -d "$bundle" ] || { echo "no such instance: $1 (cdesk create $1)" >&2; exit 1; }
  open -n "$bundle"
}

# Hand claude:// to one app. Needed only while logging a clone in or adding a
# connector to it; give it back to `main` afterwards.
cmd_claim() {
  local target="${1:-}" bundle
  [ -n "$target" ] || { echo "usage: cdesk claim <name>|main" >&2; exit 1; }

  shopt -s nullglob
  for b in "$APPS"/Claude\ *.app; do
    is_instance "$b" || continue
    url_claims "$b" off
    codesign --force --deep --sign - "$b" >/dev/null 2>&1 || true
    "$LSREG" -f "$b" >/dev/null 2>&1 || true
  done

  if [ "$target" = "main" ]; then
    bundle="$SRC"
  else
    bundle="$(bundle_of "$target")"
    [ -d "$bundle" ] || { echo "no such instance: $target" >&2; exit 1; }
    url_claims "$bundle" on
    codesign --force --deep --sign - "$bundle" >/dev/null 2>&1 || true
    "$LSREG" -f "$bundle" >/dev/null 2>&1 || true
  fi
  "$LSREG" -f "$SRC" >/dev/null 2>&1 || true
  set_scheme_owner "$bundle"
  echo "claude:// -> $(scheme_owner)"
  [ "$target" = "main" ] || echo "when done:  cdesk claim main"
}

# Anthropic's signature grants Claude.app the keychain group that holds the
# hardware device key. An ad-hoc clone cannot read it, so its account never
# registers this Mac and claude.ai answers "open the Claude desktop app on your
# computer first". The account that needs it has to run in Claude.app itself:
# link Claude.app's data dir to that profile and drop the clone.
cmd_main() {
  local name="$1" profile
  profile="$PROFILES/$(slug_of "$name")"
  [ -d "$profile" ] || { echo "no profile for $name" >&2; exit 1; }
  if pgrep -f -- "--user-data-dir=$profile" >/dev/null \
     || pgrep -f "^$SRC/Contents/MacOS/Claude( |\$)" >/dev/null; then
    echo "quit Claude $name and Claude.app first" >&2; exit 1
  fi
  if [ -L "$MAIN_DATA" ]; then
    rm "$MAIN_DATA"
  elif [ -e "$MAIN_DATA" ]; then
    local kept; kept="$MAIN_DATA.$(date +%Y%m%d-%H%M%S)"
    mv "$MAIN_DATA" "$kept"
    echo "previous Claude.app data kept at $kept"
  fi
  ln -s "$profile" "$MAIN_DATA"
  [ ! -d "$(bundle_of "$name")" ] || cmd_remove "$name"
  cmd_claim main
}

cmd_autosync() {
  case "${1:-}" in
    on)
      mkdir -p "$(dirname "$AGENT")"
      cat > "$AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.cdesk.cdesk-sync</string>
  <key>ProgramArguments</key>
  <array><string>$HOME/.local/bin/cdesk</string><string>sync</string></array>
  <key>WatchPaths</key>
  <array><string>$SRC/Contents/Info.plist</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/cdesk-sync.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/cdesk-sync.log</string>
</dict>
</plist>
EOF
      launchctl bootout "gui/$(id -u)/io.cdesk.cdesk-sync" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$AGENT"
      echo "autosync on (log: ~/Library/Logs/cdesk-sync.log)"
      ;;
    off)
      launchctl bootout "gui/$(id -u)/io.cdesk.cdesk-sync" 2>/dev/null || true
      rm -f "$AGENT"
      echo "autosync off"
      ;;
    *) echo "usage: cdesk autosync on|off" >&2; exit 1 ;;
  esac
}

# Deleting the bundle is not enough: LaunchServices keeps the registration and
# the Dock keeps the tile, so a removed instance lingers on screen pointing at
# nothing.
forget_bundle() {
  local bundle="$1" id="$2"
  "$LSREG" -u "$bundle" >/dev/null 2>&1 || true
  python3 - "$id" <<'PY' || return 0
import plistlib, subprocess, sys
wanted = sys.argv[1]
raw = subprocess.run(["defaults", "export", "com.apple.dock", "-"],
                     capture_output=True).stdout
if not raw:
    sys.exit(0)
dock = plistlib.loads(raw)
changed = False
for key in ("persistent-apps", "recent-apps"):
    tiles = dock.get(key)
    if not tiles:
        continue
    kept = [t for t in tiles
            if t.get("tile-data", {}).get("bundle-identifier") != wanted]
    if len(kept) != len(tiles):
        dock[key] = kept
        changed = True
if changed:
    subprocess.run(["defaults", "import", "com.apple.dock", "-"],
                   input=plistlib.dumps(dock))
    subprocess.run(["killall", "Dock"])
PY
}

cmd_remove() {
  local name="$1" purge="${2:-}" slug bundle
  slug="$(slug_of "$name")"; bundle="$(bundle_of "$name")"
  pkill -f -- "--user-data-dir=$PROFILES/$slug" 2>/dev/null || true
  sleep 1                                    # let it flush before we delete
  forget_bundle "$bundle" "com.anthropic.claudefordesktop.cdesk.$slug"
  rm -rf "$bundle"
  rm -f "$(marker_of "$name")"
  config_drop "$name"
  if [ "$purge" = "--purge" ]; then
    rm -rf "${PROFILES:?}/$slug"
    echo "removed '$name' and its profile"
  else
    echo "removed '$name' (profile kept at $PROFILES/$slug)"
  fi
}

[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in
  auto)      cmd_sync ;;
  apply)     cmd_apply ;;
  backup)    shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_backup "$@" ;;
  restore)   shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_restore "$@" ;;
  create)    shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_create "$@" ;;
  run)       shift; [ $# -eq 1 ] || { usage; exit 1; }; cmd_run "$1" ;;
  list|ls)   cmd_list ;;
  sync)      cmd_sync ;;
  claim)     shift; cmd_claim "${1:-}" ;;
  main)      shift; [ $# -eq 1 ] || { usage; exit 1; }; cmd_main "$1" ;;
  autosync)  shift; cmd_autosync "${1:-}" ;;
  remove|rm) shift; [ $# -ge 1 ] || { usage; exit 1; }; cmd_remove "$@" ;;
  -h|--help|help) usage ;;
  *)         usage; exit 1 ;;
esac
